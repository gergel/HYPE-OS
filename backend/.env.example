# --- Database ---
DATABASE_URL=postgresql+psycopg://hype:hype@localhost:5432/hype_os

# --- Redis (cache / queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Cloudflare R2 (Storage module) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hype-os-storage
R2_PUBLIC_URL=

# --- App ---
ENVIRONMENT=development
# "*" (alapértelmezett) minden originről engedi a hívást - Bearer token auth
# mellett ez biztonságos (nincs cookie, nincs CSRF-kockázat). Csak akkor állítsd
# konkrét domain(ek)re (vesszővel elválasztva), ha kifejezetten szűkíteni akarod.
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────
# Az alábbiak MIND opcionálisak: hiányukban az app elindul, csak az adott
# képesség jelez vissza egyértelműen (vagy csendben kihagyja a futást).
# A teljes, hiteles lista az app/core/config.py Settings osztálya.
# Magyarázat: docs/kezikonyv/11-uzemeltetes.md
# ─────────────────────────────────────────────────────────────────────────────

# --- Gmail (diszpó, szerződés, TIG küldés) ---
GMAIL_SENDER=
GMAIL_SENDER_NAME=
# A diszpó-levelek feladóneve (a küldő CÍM marad a GMAIL_SENDER)
DISPO_SENDER_NAME=HYPE GYÁRTÁS
# OAuth token JSON VAGY service account JSON + impersonation - elég az egyik
GMAIL_OAUTH_TOKEN_JSON=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_IMPERSONATE_USER=
# Másolatot kapó címek, vesszővel elválasztva
HYPE_CC=

# --- Google Docs / Drive (sablonból generált dokumentumok) ---
# A token 'drive' + 'documents' scope-ot igényel; ha üres, a GMAIL_OAUTH_TOKEN_JSON-ra esik vissza
GOOGLE_DOCS_OAUTH_TOKEN_JSON=
GDOC_DISPO_TEMPLATE_ID=
GDOC_CONTRACT_TEMPLATE_ID=
GDOC_ALVALLALKOZOI_SZERZODES_TEMPLATE_ID=
# Az ÁLLÓ (alvállalkozói) keretszerződés sablonja
GDOC_KERETSZERZODES_TEMPLATE_ID=
# Üresen hagyva a kész keretszerződés a SABLON saját mappájába kerül
GDOC_KERETSZERZODES_FOLDER_ID=
GDOC_KULSOS_TIG_TEMPLATE_ID=
GDOC_BELSOS_TIG_TEMPLATE_ID=
# Generikus kimeneti mappa - a specifikus mappák erre esnek vissza
GDOC_OUTPUT_FOLDER_ID=
DRIVE_FOLDER_ID=
DRIVE_KULSOS_TIG=
DRIVE_BELSOS_TIG=
DRIVE_DISZPO_FOLDER_ID=
# A különálló belsős-TIG program örökölt env-nevei (elfogadjuk, hogy ne kelljen
# ugyanazt a sablont/mappát/tokent új néven még egyszer felvenni)
GOOGLE_DRIVE_TEMPLATE_ID=
NOTION_FILE_FOLDER_ID=
TIGTOKEN_JSON=

# --- Google Calendar (HYPE CALENDAR szinkron, percenként) ---
# KÜLÖN Google fiók, mint a fenti Gmail/Docs. Ajánlott út: az admin felületen
# egyszer bejelentkezni (a refresh token az ADATBÁZISBA kerül), ekkor elég a
# kliens ID/secret - ha az sincs megadva, a Gmail OAuth kliensre esik vissza.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_TOKEN_JSON=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_IMPERSONATE_USER=
# Ha üres, NÉV szerint keresi a naptárat
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_NAME=HYPE CALENDAR
# Mely Google colorId-k jelentenek meetinget/helyszínbejárást (nem diszponálandó)
NAPTAR_MEETING_SZINEK=3

# --- Média Portál (publikus ügyfélfelület, /p/{slug}) ---
# A HYPE OS ADMIN felület címe - ide mutat az utókövető kérdőív linkje és a
# Google OAuth visszatérése.
FRONTEND_BASE_URL=
# A backend API saját címe (OAuth és Barion visszahívás)
API_BASE_URL=
# A PORTÁL saját, ügyfeleknek szóló domainje - ide mutat minden kiküldött link
# (megosztó link, fizetés utáni visszairányítás). Üresen a FRONTEND_BASE_URL-ra
# esik vissza, tehát egydomaines telepítésnél nincs teendő.
PORTAL_BASE_URL=
BARION_POS_KEY=
BARION_ENV=test
BARION_PAYEE=
# Üresen a fizetés érvényes marad, csak számla nem készül automatikusan
SZAMLAZZ_AGENT_KEY=
# KÜLÖN Notion adatbázis a portál-projektekhez (nem a fő HYPE OS import)
PORTAL_NOTION_API_KEY=
PORTAL_NOTION_DATABASE_ID=

# --- AI Assistant (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Notion (egyszeri, idempotens import - NEM élő szinkron) ---
NOTION_API_KEY=

# --- Papírozás hatóköre ---
# Mely projektkód-előtagok maradnak ki a szerződés/TIG/utókövetés teendőkből,
# mert a papírjaik máshol készültek el. Üresen hagyva nincs kizárás.
# Alapértelmezés (a változó teljes hiányában): HYPE24
PAPIROZAS_KIVETT_PROJEKTKODOK=HYPE24
