# --- Database ---
DATABASE_URL=postgresql+psycopg://hype:hype@localhost:5432/hype_os

# --- Redis (cache / queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Objektumtár (Storage modul + galéria-export) ---
# local = privát fájlrendszer (fejlesztés/teszt), s3 = Cloudflare R2 / S3-kompatibilis PRIVÁT bucket
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./var/storage
MEDIA_OBJECT_PREFIX=media/

# --- Cloudflare R2 (STORAGE_BACKEND=s3 esetén) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hype-os-storage
R2_PUBLIC_URL=
# opcionális: explicit endpoint (alapból https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=
R2_REGION=auto

# --- Galéria ZIP64 export ---
EXPORT_OBJECT_PREFIX=exports/
EXPORT_TTL_HOURS=48
EXPORT_DOWNLOAD_URL_TTL_SECONDS=900
EXPORT_WORKER_CONCURRENCY=2
EXPORT_MAX_ATTEMPTS=3
EXPORT_LEASE_SECONDS=120
EXPORT_CHUNK_BYTES=8388608
EXPORT_S3_MULTIPART_PART_BYTES=67108864
EXPORT_MAX_FILES=200000
EXPORT_ZIP_STREAMING_MODE=true

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
